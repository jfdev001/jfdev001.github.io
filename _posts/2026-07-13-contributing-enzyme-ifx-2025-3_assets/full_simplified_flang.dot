// @brief Simplified flang pipeline, no I/O shown
// https://github.com/llvm/llvm-project/blob/main/flang/docs/Overview.md
digraph FlangPipeline {
    rankdir=LR;
    splines=ortho;
    nodesep=0.5;
    ranksep=0.8;

    node [shape=box, style="rounded"];

    // -------------
    // ANALYSIS 
    // -------------

    // input analysis phase 
    Source [label="Fortran Source\n(.f90, headers)"];

    subgraph cluster_analysis {
        label="Analysis";
        style=rounded;

        Prescan [
            label="Prescan/Preprocessing"
        ];

        Parsing [
            label="Parsing"
        ];

        SemanticProcessing [
            label="Semantic Processing"
        ];
    }


    // ---------------
    // LOWERING 
    // ---------------

    subgraph cluster_lowering {
        label="Lowering";
        style=rounded;

        CreateLoweringBridge [
            label="Create Lowering Bridge"
        ];

        InitialLowering [
            label="Initial Lowering"
        ];

        TransformationPasses [
            label="Transformation Passes"
        ];
    }


    // ----------
    // LLC 
    // ----------
    subgraph cluster_codegen {
        label="Object Code Generation and Linking";
        style=rounded;

        subgraph cluster_llc {
        label="llc";
        style="rounded,dashed";
        Compiler [
            label="Compiler (llc -filetype=obj)"
        ];

        Linker [
            label="Linker (ld.lld)"
        ];


        Compiler -> Linker;
        }
    }

    // ---
    // Total pipeline
    // ---
    Source [shape=note]

    // Analysis
    Source -> Prescan;
    Prescan -> Parsing;
    Parsing -> SemanticProcessing;

    // lowering
    SemanticProcessing -> CreateLoweringBridge;
    CreateLoweringBridge -> InitialLowering;
    InitialLowering -> TransformationPasses;

    // code generation
    TransformationPasses -> Compiler;
}
