digraph FlangPipeline {
    rankdir=TB;
    splines=ortho;
    nodesep=0.4;
    ranksep=0.5;

    node [
        shape=box,
        style="rounded",
        fontname="Helvetica",
        fontsize=12
    ];

    edge [
        arrowsize=0.8
    ];

    Source [
        label="Fortran Source"
    ];

    subgraph cluster_analysis {
        label="Analysis";
        style=rounded;

        Preprocess [
            label="Prescan &\nPreprocessing"
        ];

        Cooked [
            label="Cooked Character\nStream",
            shape=note
        ];

        Parse [
            label="Parsing"
        ];

        ParseTree [
            label="Parse Tree",
            shape=note
        ];

        Semantics [
            label="Semantic Analysis"
        ];

        Decorated [
            label="Decorated Parse Tree\n+\nSymbol Table",
            shape=note
        ];

        Preprocess -> Cooked;
        Cooked -> Parse;
        Parse -> ParseTree;
        ParseTree -> Semantics;
        Semantics -> Decorated;
    }

    subgraph cluster_lowering {
        label="Lowering";
        style=rounded;

        PFT [
            label="Pre-FIR Tree (PFT)"
        ];

        FIR [
            label="FIR (MLIR)"
        ];

        Passes [
            label="MLIR/FIR Pass Pipeline"
        ];

        Decorated -> PFT;
        PFT -> FIR;
        FIR -> Passes;
    }

    subgraph cluster_codegen {
        label="Code Generation & Linking";
        style=rounded;

        LLVM [
            label="LLVM IR"
        ];

        Object [
            label="Object Code"
        ];

        Executable [
            label="Executable"
        ];

        Passes -> LLVM;
        LLVM -> Object;
        Object -> Executable;
    }

    Source -> Preprocess;
}
