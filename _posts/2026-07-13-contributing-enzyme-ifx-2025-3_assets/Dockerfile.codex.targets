# ============================================================
# Base image
# ============================================================

# NOTE: As of 2026-06, this is the Ubuntu version used in GitHub Actions.
FROM ubuntu:22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

# Base dependencies
RUN apt-get update && apt-get install -y \
    sudo \
    software-properties-common \
    wget \
    curl \
    cmake \
    ninja-build \
    python3-pip \
    libzstd-dev \
    libedit-dev \
    libcurl4-openssl-dev \
    less \
    ca-certificates && \
    add-apt-repository ppa:ubuntu-toolchain-r/test -y && \
    apt-get update && \
    apt-get install -y gcc-13 g++-13 && \
    update-alternatives \
        --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-13 && \
    pip install lit

# Intel repository
RUN wget https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB && \
    apt-key add GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB && \
    echo "deb https://apt.repos.intel.com/oneapi all main" \
        > /etc/apt/sources.list.d/oneAPI.list

# Install Node.js + pnpm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && \
    apt-get install -y nodejs && \
    npm install -g pnpm

# Create user
RUN useradd -m -G sudo -s /bin/bash user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Allow scripts to detect they are running inside the container
ENV IS_CONTAINER=TRUE

USER user
WORKDIR /home/user

# Install Codex into its own tool directory
RUN mkdir tools && \
    cd tools && \
    pnpm init && \
    pnpm add @openai/codex

USER root

# Wrapper so "codex" works from anywhere
RUN printf '#!/bin/bash\ncd /home/user/tools\nexec pnpm exec codex "$@"\n' \
    > /usr/local/bin/codex && \
    chmod +x /usr/local/bin/codex

USER user

# ============================================================
# IFX 2025.3 + LLVM 21
# ============================================================

FROM base AS ifx2025_llvm21

USER root

RUN wget --no-check-certificate -O - https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - && \
    apt-add-repository -y \
        "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-21 main" && \
    apt-get update && \
    apt-get install -y \
        llvm-21-dev \
        intel-oneapi-compiler-fortran-2025.3

USER user

ENV LLVM_VERSION=21
ENV IFX_VERSION=2025.3

# ============================================================
# IFX 2023.0.0 + LLVM 15
# ============================================================

FROM base AS ifx2023_llvm15

USER root

RUN wget --no-check-certificate -O - https://apt.llvm.org/llvm-snapshot.gpg.key | apt-key add - && \
    apt-add-repository -y \
        "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-15 main" && \
    apt-get update && \
    apt-get install -y \
        llvm-15-dev \
        intel-oneapi-compiler-fortran-2023.0.0

USER user

ENV LLVM_VERSION=15
ENV IFX_VERSION=2023.0.0
